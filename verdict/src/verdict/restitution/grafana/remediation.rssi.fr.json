{
  "__inputs": [
    {
      "name": "DS_A2VM",
      "label": "Base de restitution A2VM",
      "description": "Source de données PostgreSQL de la base de restitution",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    },
    {
      "name": "VAR_DISPATCH_URL",
      "type": "constant",
      "label": "Adresse de la page des demandes de remédiation",
      "value": "https://dispatch.example.org",
      "description": "https://<host of A2VM_DISPATCH_HOST>"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "timeseries",
      "version": ""
    }
  ],
  "title": "A2VM — remédiation (demandes de remédiation)",
  "uid": "a2vm-remediation-fr-rssi",
  "tags": [
    "a2vm",
    "fr",
    "rssi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "a2vm"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "A2VM"
    },
    {
      "type": "link",
      "title": "Demander la remédiation de tous les ACT",
      "url": "${dispatch_url}/remediate?level=ACT",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Demander la remédiation de tous les ACT",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Client",
        "description": "",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_A2VM}"
        },
        "query": "SELECT tenant AS __value, tenant_name AS __text FROM a2vm.latest_runs ORDER BY tenant_name",
        "definition": "SELECT tenant AS __value, tenant_name AS __text FROM a2vm.latest_runs ORDER BY tenant_name",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {}
      },
      {
        "name": "dispatch_url",
        "type": "constant",
        "hide": 2,
        "query": "${VAR_DISPATCH_URL}",
        "current": {
          "text": "${VAR_DISPATCH_URL}",
          "value": "${VAR_DISPATCH_URL}"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Constats corrigés",
      "description": "Constats disparus d'un run alors que leur actif a été scanné à nouveau par la source qui les avait vus (période du tableau de bord).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM a2vm.finding_closures WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND $__timeFilter(closed_at) AND outcome = 'fixed'"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Délai moyen de correction d'un ACT",
      "description": "De la première observation du constat au run qui l'a vu corrigé.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(days_open) AS value FROM a2vm.finding_closures WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND $__timeFilter(closed_at) AND outcome = 'fixed' AND level = 'ACT'"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Corrigés dans l'échéance BOD 26-04",
      "description": "Part des constats ACT et ATTEND corrigés au plus tard à leur échéance.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * avg(CASE WHEN within_due THEN 1 ELSE 0 END) AS value FROM a2vm.finding_closures WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND $__timeFilter(closed_at) AND outcome = 'fixed' AND level IN ('ACT', 'ATTEND') AND within_due IS NOT NULL"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Disparus sans nouveau scan",
      "description": "Constats disparus d'un run alors que leur actif n'a pas été scanné à nouveau par la source qui les avait vus : correction non établie.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM a2vm.finding_closures WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND $__timeFilter(closed_at) AND outcome = 'unverified'"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Actifs non scannés depuis 7 jours",
      "description": "Actifs du dernier run dont le dernier scan date de plus de 7 jours, ou est inconnu.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM a2vm.latest_asset_scans WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND (last_scan IS NULL OR last_scan < generated_at - interval '7 days')"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "dark-orange"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Constats réouverts",
      "description": "Constats corrigés sur la période et revus dans un run ultérieur.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM a2vm.finding_closures c WHERE c.tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND $__timeFilter(c.closed_at) AND c.outcome = 'fixed' AND EXISTS (SELECT 1 FROM a2vm.decisions d JOIN a2vm.runs r USING (run_id) WHERE d.tenant = c.tenant AND d.finding_id = c.finding_id AND r.generated_at > c.closed_at)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Constats corrigés par jour",
      "description": "Constats corrigés chaque jour, par niveau.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamptz AS time, count(*) FILTER (WHERE level = 'ACT') AS \"ACT\", count(*) FILTER (WHERE level = 'ATTEND') AS \"ATTEND\", count(*) FILTER (WHERE level = 'TRACK') AS \"TRACK\" FROM a2vm.finding_closures WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND $__timeFilter(closed_at) AND outcome = 'fixed' GROUP BY day ORDER BY day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "always"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ACT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ATTEND"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TRACK"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Délai de correction par niveau",
      "description": "Par niveau : constats corrigés, délais moyen et médian de la première observation à la correction, part corrigée dans l'échéance (pas d'échéance pour TRACK).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT l.level AS \"Niveau\", count(c.finding_id) AS \"Corrigés\", round(avg(c.days_open), 1) AS \"Jours (moyenne)\", percentile_cont(0.5) WITHIN GROUP (ORDER BY c.days_open) AS \"Jours (médiane)\", round(100.0 * avg(CASE WHEN c.within_due THEN 1 WHEN c.within_due IS NOT NULL THEN 0 END), 1) AS \"Dans l'échéance (%)\"\nFROM (VALUES ('ACT', 1), ('ATTEND', 2), ('TRACK', 3)) l (level, o)\nLEFT JOIN a2vm.finding_closures c ON c.level = l.level AND c.outcome = 'fixed' AND c.tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND $__timeFilter(c.closed_at)\nGROUP BY l.level, l.o ORDER BY l.o"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Niveau"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ACT": {
                        "color": "red",
                        "index": 0
                      },
                      "ATTEND": {
                        "color": "orange",
                        "index": 1
                      },
                      "TRACK": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Corrigés récemment",
      "description": "Les constats corrigés sur la période, les plus récents d'abord.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT asset_name AS \"Actif\", cve AS \"CVE\", level AS \"Niveau\", first_seen AS \"Première observation\", day AS \"Corrigé le\", days_open AS \"Jours ouvert\", within_due AS \"Dans l'échéance\" FROM a2vm.finding_closures WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND $__timeFilter(closed_at) AND outcome = 'fixed' ORDER BY closed_at DESC, level_rank, cve LIMIT 500"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Niveau"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ACT": {
                        "color": "red",
                        "index": 0
                      },
                      "ATTEND": {
                        "color": "orange",
                        "index": 1
                      },
                      "TRACK": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Actifs par dernier scan",
      "description": "Tous les actifs du dernier run, les moins récemment scannés d'abord ; un actif scanné sans constat n'en montre aucun.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT asset_name AS \"Actif\", last_scan AS \"Dernier scan\", (SELECT string_agg(k, ', ' ORDER BY k) FROM jsonb_object_keys(coalesce(scans, '{}'::jsonb)) k) AS \"Sources\", act AS \"ACT\", attend AS \"ATTEND\", track AS \"TRACK\" FROM a2vm.latest_asset_scans WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) ORDER BY last_scan NULLS FIRST, asset_name"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Actif"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Demander la remédiation de cet actif",
                    "url": "${dispatch_url}/remediate?asset=${__value.raw:percentencode}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 10
    },
    {
      "type": "table",
      "title": "Constats disparus sans nouveau scan",
      "description": "Constats disparus sans nouveau scan de leur actif : vérifier les scans de ces actifs.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT asset_name AS \"Actif\", cve AS \"CVE\", level AS \"Niveau\", day AS \"Disparu le\" FROM a2vm.finding_closures WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND $__timeFilter(closed_at) AND outcome = 'unverified' ORDER BY closed_at DESC, level_rank LIMIT 500"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Niveau"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ACT": {
                        "color": "red",
                        "index": 0
                      },
                      "ATTEND": {
                        "color": "orange",
                        "index": 1
                      },
                      "TRACK": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 11
    }
  ]
}

#cloud-config
# NGVM cloud scanner, first boot (Ubuntu 24.04): Docker, Greenbone Community Edition in containers,
# GitLab Runner (Docker executor) for the client's external project. Rendered by Terraform
# templatefile(): a doubled dollar sign is a shell variable, a single one a Terraform value.
package_update: true
package_upgrade: true
packages:
  - docker.io
  - docker-compose-v2
  - curl
  - openssl
  - ca-certificates

write_files:
  - path: /opt/ngvm-scanner/scanner.env
    permissions: "0644"
    content: |
      GITLAB_URL=${gitlab_url}
      RUNNER_TAG=${runner_tag}
      COMPOSE_URL=${greenbone_compose_url}
      COMPOSE_PROJECT=greenbone-community-edition
      SOCKET_VOLUME=greenbone-community-edition_gvmd_socket_vol
      GVM_USER=vulnops

  - path: /opt/ngvm-scanner/lib.sh
    permissions: "0644"
    content: |
      # Shared by the scripts of /opt/ngvm-scanner.
      set -euo pipefail
      . /opt/ngvm-scanner/scanner.env
      D=/opt/ngvm-scanner
      gb() { docker compose -p "$COMPOSE_PROJECT" -f "$D/greenbone/compose.yaml" "$@"; }
      gvmd_cmd() { gb exec -T -u gvmd gvmd gvmd "$@"; }
      # Quiet gvmd command: its messages only when it fails.
      gvmd_quiet() { local out; out=$(gvmd_cmd "$@" 2>&1) || { printf '%s\n' "$out" >&2; return 1; }; }
      # Read from the configuration: the runner's own listing prints the tokens.
      RUNNER_CONFIG=/etc/gitlab-runner/config.toml
      runner_registered() { grep -q '^\[\[runners\]\]' "$RUNNER_CONFIG" 2>/dev/null; }

  - path: /opt/ngvm-scanner/gvm-users.sh
    permissions: "0700"
    content: |
      #!/bin/bash
      # The GMP account of NGVM (role User) and the password of the web interface's admin, from
      # the secrets generated at first boot. Waits for gvmd (up to 30 minutes at first start).
      . /opt/ngvm-scanner/lib.sh
      for i in $(seq 1 180); do
        if users=$(gvmd_cmd --get-users 2>/dev/null); then break; fi
        [ "$i" -lt 180 ] || { echo "gvmd does not answer after 30 minutes: $D/status.sh" >&2; exit 1; }
        sleep 10
      done
      pw=$(cat "$D/secrets/gvm-password.txt")
      if printf '%s\n' "$users" | grep -qx "$GVM_USER"; then
        gvmd_quiet --user="$GVM_USER" --new-password="$pw"
      else
        gvmd_quiet --create-user="$GVM_USER" --role=User --password="$pw"
      fi
      if printf '%s\n' "$users" | grep -qx admin; then
        gvmd_quiet --user=admin --new-password="$(cat "$D/secrets/gvm-admin.txt")"
      fi
      echo "gvmd: account $GVM_USER ready"

  - path: /opt/ngvm-scanner/register-runner.sh
    permissions: "0700"
    content: |
      #!/bin/bash
      # Registers the runner of the external project. The runner authentication token (glrt-...)
      # is read on stdin, never on the command line:
      #   ... | ssh root@<scanner> /opt/ngvm-scanner/register-runner.sh
      # A client certificate for the GitLab reverse proxy, when it asks for one, is copied first to
      # /opt/ngvm-scanner/certs/client.crt and client.key (ca.pem: a private CA of GitLab).
      . /opt/ngvm-scanner/lib.sh
      IFS= read -r token || true
      token=$(printf '%s' "$token" | tr -d '[:space:]')
      case "$token" in
        glrt-*) ;;
        *) echo "expected a runner authentication token (glrt-...) on stdin" >&2; exit 2 ;;
      esac
      "$D/gvm-users.sh"
      umask 077
      tpl="$D/secrets/runner-template.toml"
      trap 'rm -f "$tpl"' EXIT
      {
        echo '[[runners]]'
        printf '  environment = ["NGVM_SERVER_URL=%s", "NGVM_GVM_USER=%s", "NGVM_GVM_PASSWORD=%s"]\n' \
          "$GITLAB_URL" "$GVM_USER" "$(cat "$D/secrets/gvm-password.txt")"
        if [ -s "$D/certs/client.crt" ] && [ -s "$D/certs/client.key" ]; then
          printf '  tls-cert-file = "%s"\n  tls-key-file = "%s"\n' "$D/certs/client.crt" "$D/certs/client.key"
        fi
        if [ -s "$D/certs/ca.pem" ]; then printf '  tls-ca-file = "%s"\n' "$D/certs/ca.pem"; fi
        echo '  [runners.docker]'
        printf '    volumes = ["/cache", "%s:/run/gvmd"]\n' "$SOCKET_VOLUME"
      } > "$tpl"
      # A registration made before is removed: in GitLab when it still exists there, else locally.
      if runner_registered; then
        gitlab-runner unregister --all-runners || true
        if runner_registered; then sed -i '/^\[\[runners\]\]/,$d' "$RUNNER_CONFIG"; fi
      fi
      CI_SERVER_TOKEN="$token" gitlab-runner register --non-interactive \
        --url "$GITLAB_URL" --clone-url "$GITLAB_URL" --name "$(hostname)" \
        --executor docker --docker-image alpine:3 --template-config "$tpl"
      sed -i 's/^concurrent = .*/concurrent = 1/' /etc/gitlab-runner/config.toml
      systemctl restart gitlab-runner
      gitlab-runner verify 2>&1 | grep -v '^Runtime platform' | sed -E 's/\x1b\[[0-9;]*m//g'
      echo "runner registered: jobs tagged $RUNNER_TAG in the project of this token run here"

  - path: /opt/ngvm-scanner/status.sh
    permissions: "0700"
    content: |
      #!/bin/bash
      # State of the scanner: containers, feeds, GMP account, runner. Never prints a secret; a part
      # that does not answer within 20 s is skipped (gvmd waits on its lock while it loads the feeds).
      . /opt/ngvm-scanner/lib.sh
      set +e
      echo "== first boot"; cloud-init status
      echo "== containers"; gb ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}'
      echo "== feeds (NVTs loaded; a scan before the first synchronisation finds little)"
      timeout 20 docker compose -p "$COMPOSE_PROJECT" -f "$D/greenbone/compose.yaml" exec -T -u postgres pg-gvm \
        psql -d gvmd -tAc 'SELECT count(*) FROM nvts;' 2>/dev/null || echo "not yet"
      echo "== GMP accounts"
      timeout 20 docker compose -p "$COMPOSE_PROJECT" -f "$D/greenbone/compose.yaml" exec -T -u gvmd gvmd \
        gvmd --get-users 2>/dev/null || echo "gvmd busy (loading the feeds) or not ready"
      echo "== runner"
      if runner_registered; then
        grep -E '^ *(name|url) = ' "$RUNNER_CONFIG" | sed 's/^ *//'
      else
        echo "not registered (register-runner.sh)"
      fi
      echo "== disk"
      df -h --output=size,used,avail,pcent /
      used=$(df --output=pcent / | tail -1 | tr -dc 0-9)
      if [ "$used" -ge 85 ]; then
        echo "WARNING: less than 15 % free: $D/cleanup.sh, then docker system df"
      fi
      echo "== feed update and cleanup"; systemctl list-timers ngvm-greenbone-feed.timer --no-pager | head -2

  - path: /opt/ngvm-scanner/feed-update.sh
    permissions: "0700"
    content: |
      #!/bin/bash
      # Newer feed images (and Greenbone components), then the containers that changed restart,
      # then the disk is cleaned up.
      . /opt/ngvm-scanner/lib.sh
      gb pull --quiet
      gb up -d --remove-orphans
      "$D/cleanup.sh"

  - path: /opt/ngvm-scanner/cleanup.sh
    permissions: "0700"
    content: |
      #!/bin/bash
      # Disk housekeeping, every night after the feed update: the stopped containers of the CI jobs,
      # the images no container uses for 3 days, the runner's cache volumes no container uses, the
      # system journal above 200 MB and the package cache. Greenbone is never touched: its
      # containers (running, or stopped once their feed data is copied) keep their images, and its
      # volumes are not the runner's.
      . /opt/ngvm-scanner/lib.sh
      free() { df --output=avail -BG / | tail -1 | tr -dc 0-9; }
      before=$(free)
      docker container prune -f --filter "label!=com.docker.compose.project=$COMPOSE_PROJECT" > /dev/null
      docker image prune -af --filter "until=72h" > /dev/null
      docker volume ls -q --filter dangling=true | grep '^runner-' | xargs -r docker volume rm > /dev/null
      journalctl --vacuum-size=200M > /dev/null 2>&1 || true
      apt-get clean
      echo "cleanup: $before GB free before, $(free) GB after"

  - path: /etc/systemd/system/ngvm-greenbone-feed.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Greenbone feed update and disk cleanup (NGVM scanner)
      After=docker.service
      Requires=docker.service

      [Service]
      Type=oneshot
      ExecStart=/opt/ngvm-scanner/feed-update.sh

  - path: /etc/systemd/system/ngvm-greenbone-feed.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Daily Greenbone feed update and disk cleanup (NGVM scanner)

      [Timer]
      OnCalendar=${feed_update_time}
      Persistent=true

      [Install]
      WantedBy=timers.target

  - path: /opt/ngvm-scanner/bootstrap.sh
    permissions: "0700"
    content: |
      #!/bin/bash
      # Secrets generated here, once: they never leave the instance.
      . /opt/ngvm-scanner/lib.sh
      umask 077
      mkdir -p "$D/secrets" "$D/certs" "$D/greenbone"
      for s in gvm-password gvm-admin; do
        [ -s "$D/secrets/$s.txt" ] || openssl rand -base64 24 | tr -d '/+=' > "$D/secrets/$s.txt"
      done
      umask 022
      systemctl enable --now docker
      curl -fsSL "$COMPOSE_URL" -o "$D/greenbone/compose.yaml"
      gb pull --quiet
      gb up -d
      curl -fsSL https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.deb.sh | bash
      apt-get install -y gitlab-runner
      systemctl daemon-reload
      systemctl enable --now gitlab-runner ngvm-greenbone-feed.timer
      "$D/gvm-users.sh"

runcmd:
  - [/opt/ngvm-scanner/bootstrap.sh]

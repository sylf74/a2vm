      "tooltip": "Demander la remédiation de tous les ACT",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Client",
        "description": "",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_A2VM}"
        },
        "query": "SELECT tenant AS __value, tenant_name AS __text FROM a2vm.latest_runs ORDER BY tenant_name",
        "definition": "SELECT tenant AS __value, tenant_name AS __text FROM a2vm.latest_runs ORDER BY tenant_name",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {}
      },
      {
        "name": "state",
        "label": "Couverture",
        "description": "États de couverture affichés dans le tableau",
        "type": "custom",
        "query": "not-in-cmdb,retired-but-alive,never-scanned,stale,partial,not-scannable,not-expected,covered",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "Tous"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "dispatch_url",
        "type": "constant",
        "hide": 2,
        "query": "${VAR_DISPATCH_URL}",
        "current": {
          "text": "${VAR_DISPATCH_URL}",
          "value": "${VAR_DISPATCH_URL}"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Couverts",
      "description": "Part des actifs en production dans la CMDB que chaque moyen de détection attendu a vus dans le délai stale_days du client (dernier run).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE state = 'covered') / nullif(count(*) FILTER (WHERE in_production), 0) AS value FROM a2vm.latest_coverage WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[])"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 1
    },

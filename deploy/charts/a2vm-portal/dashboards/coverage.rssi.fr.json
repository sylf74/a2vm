    {
      "type": "dashboards",
      "tags": [
        "a2vm"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "A2VM"
    },
    {
      "type": "link",
      "title": "Demander la remédiation de tous les ACT",
      "url": "${dispatch_url}/remediate?level=ACT",
      "targetBlank": true,

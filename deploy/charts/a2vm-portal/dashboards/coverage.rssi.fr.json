    {
      "type": "table",
      "title": "Couverture par classe",
      "description": "Par classe de la CMDB, les actifs dans chaque état de couverture.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT cmdb_class AS \"Classe\", count(*) AS \"Actifs\", count(*) FILTER (WHERE state = 'not-in-cmdb') AS \"not-in-cmdb\", count(*) FILTER (WHERE state = 'retired-but-alive') AS \"retired-but-alive\", count(*) FILTER (WHERE state = 'never-scanned') AS \"never-scanned\", count(*) FILTER (WHERE state = 'stale') AS \"stale\", count(*) FILTER (WHERE state = 'partial') AS \"partial\", count(*) FILTER (WHERE state = 'not-scannable') AS \"not-scannable\", count(*) FILTER (WHERE state = 'not-expected') AS \"not-expected\", count(*) FILTER (WHERE state = 'covered') AS \"covered\" FROM a2vm.latest_coverage WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) GROUP BY cmdb_class ORDER BY count(*) DESC, cmdb_class"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Part couverte, run après run",
      "description": "Part des actifs en production couverts, à chaque run (période du tableau de bord).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT generated_at AS time, 100.0 * covered_assets / nullif(expected_assets, 0) AS \"Couverts\" FROM a2vm.runs WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND expected_assets IS NOT NULL AND $__timeFilter(generated_at) ORDER BY generated_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "always"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ACT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ATTEND"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TRACK"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 14,
        "y": 16,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 11
    }
  ]

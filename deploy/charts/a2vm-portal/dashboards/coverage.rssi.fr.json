    {
      "type": "table",
      "title": "Actifs et moyens de détection",
      "description": "Chaque hôte du dernier run : son élément de configuration, sa couverture, les moyens manquants, et pour chaque moyen de détection la date à laquelle il a vu l'actif pour la dernière fois.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT asset_name AS \"Actif\", cmdb_class AS \"Classe\", cmdb_status AS \"Statut CMDB\", criticality AS \"Criticité\", state AS \"Couverture\", array_to_string(missing, ', ') AS \"Manquants\", (scans ->> 'openvas')::timestamptz AS \"OpenVAS\", (scans ->> 'trivy')::timestamptz AS \"Trivy\", (scans ->> 'dnf-updateinfo')::timestamptz AS \"dnf\", (scans ->> 'external-scan')::timestamptz AS \"Scan externe\", (SELECT string_agg(k, ', ' ORDER BY k) FROM jsonb_object_keys(coalesce(scans, '{}'::jsonb)) k WHERE k NOT IN ('openvas', 'trivy', 'dnf-updateinfo', 'external-scan')) AS \"Autres moyens\", days_since_scan AS \"Jours depuis le scan\", owner AS \"Responsable\" FROM a2vm.latest_coverage WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND state = ANY (ARRAY[${state:sqlstring}]::text[]) ORDER BY state_rank, criticality, asset_name"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Couverture"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "not-in-cmdb": {
                        "color": "purple",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "retired-but-alive": {
                        "color": "dark-red",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "never-scanned": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "stale": {
                        "color": "orange",
                        "index": 3
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "partial": {
                        "color": "yellow",
                        "index": 4
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "not-scannable": {
                        "color": "blue",
                        "index": 5
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "not-expected": {
                        "color": "text",
                        "index": 6
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "covered": {
                        "color": "green",
                        "index": 7
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Actif"
            },
            "properties": [
              {
                "id": "links",
                "value": [

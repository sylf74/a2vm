        "x": 14,
        "y": 4,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 10
    },
    {
      "type": "table",
      "title": "Exposure gaps",
      "description": "Hosts the external scan reaches that the client profile does not describe",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT name AS \"Asset\", kind AS \"Gap\", declared AS \"Declared\", detail AS \"Detail\" FROM a2vm.latest_exposure_gaps WHERE tenant = '${tenant}' ORDER BY kind, name"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 11
    },
    {
      "type": "table",
      "title": "Decisions to act on (ACT, ATTEND)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT level AS \"Level\", cve AS \"CVE\", asset_name AS \"Asset\", zone AS \"Zone\", exposure AS \"Exposure\", bod_timeline AS \"BOD 26-04\", due_date AS \"Due\", kev AS \"KEV\", round(epss::numeric, 3) AS \"EPSS\", needs_review AS \"Review\", title AS \"Vulnerability\" FROM a2vm.latest_decisions WHERE tenant = '${tenant}' AND level IN ('ACT', 'ATTEND') ORDER BY CASE level WHEN 'ACT' THEN 0 ELSE 1 END, due_date NULLS LAST, cve"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Level"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ACT": {
                        "color": "red",
                        "index": 0
                      },
                      "ATTEND": {
                        "color": "orange",
                        "index": 1
                      },
                      "TRACK": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 12
    },

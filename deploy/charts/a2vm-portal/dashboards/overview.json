      "type": "table",
      "title": "Assets",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT name AS \"Asset\", zone AS \"Zone\", exposure AS \"Exposure\", owner AS \"Owner\", act AS \"ACT\", attend AS \"ATTEND\", track AS \"TRACK\" FROM a2vm.latest_assets WHERE tenant = '${tenant}' ORDER BY act DESC, attend DESC, name"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 13
    },
    {
      "type": "table",
      "title": "Detection sources (latest run)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_A2VM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.name AS \"Source\", s.findings AS \"Findings\", s.last_observation AS \"Last observation\" FROM a2vm.sources s JOIN a2vm.latest_runs r USING (run_id) WHERE r.tenant = '${tenant}' ORDER BY 1"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 14,
        "y": 27,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_A2VM}"
      },
      "id": 14
    }
  ]
}

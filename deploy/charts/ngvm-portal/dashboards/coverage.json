{
  "__inputs": [
    {
      "name": "DS_NGVM",
      "label": "NGVM reporting database",
      "description": "PostgreSQL data source of the reporting database",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "timeseries",
      "version": ""
    }
  ],
  "title": "NGVM — assets and scan coverage",
  "uid": "ngvm-coverage",
  "tags": [
    "ngvm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ngvm"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "NGVM"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Client",
        "description": "",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_NGVM}"
        },
        "query": "SELECT tenant AS __value, tenant_name AS __text FROM ngvm.latest_runs ORDER BY tenant_name",
        "definition": "SELECT tenant AS __value, tenant_name AS __text FROM ngvm.latest_runs ORDER BY tenant_name",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {}
      },
      {
        "name": "state",
        "label": "Coverage",
        "description": "States of the coverage shown in the table",
        "type": "custom",
        "query": "not-in-cmdb,retired-but-alive,never-scanned,stale,partial,not-scannable,not-expected,covered",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Covered",
      "description": "Share of the assets in production in the CMDB that every expected means of detection saw within the tenant's stale_days (latest run).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_NGVM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE state = 'covered') / nullif(count(*) FILTER (WHERE in_production), 0) AS value FROM ngvm.latest_coverage WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[])"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_NGVM}"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "In production",
      "description": "Assets the CMDB expects to be scanned (in production), or every host when the run has no CMDB.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_NGVM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM ngvm.latest_coverage WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND in_production"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_NGVM}"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Never scanned",
      "description": "In production, never seen by a scan.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_NGVM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM ngvm.latest_coverage WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND state = 'never-scanned'"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_NGVM}"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Stale",
      "description": "In production, last scan older than the tenant's stale_days.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_NGVM}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM ngvm.latest_coverage WHERE tenant = ANY (ARRAY[${tenant:sqlstring}]::text[]) AND state = 'stale'"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]

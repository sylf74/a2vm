{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab/voc/cve-triage/client_profile.schema.json",
  "title": "Client profile for CVE triage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "updated": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "delivery_file": {
          "type": "string",
          "description": "Optional link to the client's delivery-files sheet."
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "description", "vendor", "product", "exposure",
          "mission_prevalence", "public_wellbeing_impact", "owner"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "description": {"type": "string", "minLength": 1},
          "vendor": {"type": "string", "minLength": 1},
          "product": {"type": "string", "minLength": 1},
          "vendor_aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "product_aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "cpe": {
            "type": "string",
            "pattern": "^cpe:2\\.3:[aho]:[^:]+:[^:]+",
            "description": "CPE 2.3 prefix; only the vendor and product fields are used for matching."
          },
          "versions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true,
            "description": "Deployed versions. Empty or absent: every matching CVE is triaged with version status 'unknown'."
          },
          "exposure": {
            "enum": ["internet", "internal", "isolated"],
            "description": "internet = reachable by unauthenticated or untrusted entities via public networks (CISA 'Publicly Exposed')."
          },
          "mission_prevalence": {"enum": ["minimal", "support", "essential"]},
          "public_wellbeing_impact": {"enum": ["minimal", "material", "irreversible"]},
          "owner": {"type": "string", "minLength": 1, "description": "Team or mailbox in charge of remediation."}
        }
      }
    }
  }
}

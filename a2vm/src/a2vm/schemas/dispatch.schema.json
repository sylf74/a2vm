{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a2vm/dispatch.schema.json",
  "title": "A2VM dispatch rules of a tenant",
  "description": "dispatch.yaml of a tenant project (pillar 4, LLD dispatch §4): the tools the decisions go to and the rules of what leaves. No credential: they are CI/CD variables.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"enum": ["dry-run", "live"], "description": "dry-run (default): proposed and logged, nothing sent; live: sent"},
    "targets": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,30}$"},
      "additionalProperties": {"$ref": "#/$defs/itop"}
    },
    "tickets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {"type": "string"},
        "automatic": {"enum": ["none", "act", "act-attend"], "description": "what leaves after each run by itself (default act)"},
        "exclude_zones": {"type": "array", "items": {"type": "string"}},
        "resolve_when_fixed": {"type": "boolean"},
        "reopen_when_still_seen": {"type": "boolean"}
      }
    },
    "requests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "levels": {"type": "array", "items": {"enum": ["ACT", "ATTEND", "TRACK"]}, "minItems": 1},
        "max_tickets": {"type": "integer", "minimum": 1, "maximum": 500}
      }
    }
  },
  "$defs": {
    "itop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "user", "organization", "caller"],
      "properties": {
        "type": {"const": "itop"},
        "url": {"type": "string", "pattern": "^https?://"},
        "user": {"type": "string", "minLength": 1},
        "organization": {"type": "string", "minLength": 1, "description": "name of the iTop organisation of the tickets"},
        "caller": {"type": "string", "minLength": 1, "description": "name of the iTop Person the tickets come from"},
        "class": {"enum": ["UserRequest"]},
        "team": {"type": "string", "description": "optional: name of the iTop Team the tickets are assigned to"},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 600}
      }
    }
  }
}

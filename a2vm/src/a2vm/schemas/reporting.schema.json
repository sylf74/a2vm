{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a2vm.reporting/1",
  "title": "Reporting dataset of a triage run (the client portal reads this file only)",
  "description": "One tenant per file. Within /1 fields are only added; a field removed or changed in meaning makes /2.",
  "type": "object",
  "required": ["schema", "generated_at", "run", "totals", "by_exposure", "by_zone", "deadlines", "decisions", "assets"],
  "properties": {
    "schema": {"const": "a2vm.reporting/1"},
    "generated_at": {"type": "string"},
    "run": {
      "type": "object",
      "required": ["tenant", "a2vm_version", "policy_hash", "pipeline", "sources", "cve_count"],
      "properties": {
        "tenant": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {"id": {"type": "string"}, "name": {"type": "string"}}
        },
        "a2vm_version": {"type": "string"},
        "policy_hash": {"type": "string", "description": "Hash of the decision policy in force"},
        "pipeline": {
          "type": "object",
          "properties": {"id": {"type": "string"}, "url": {"type": "string"}}
        },
        "sources": {
          "type": "array",
          "description": "Detection sources of the run: findings they observed and their latest observation (external-scan when the external scan was joined)",
          "items": {
            "type": "object",
            "required": ["name", "findings", "last_observation"],
            "properties": {
              "name": {"type": "string"},
              "findings": {"type": "integer", "minimum": 0},
              "last_observation": {"type": "string"}
            }
          }
        },
        "cve_count": {"type": "integer", "minimum": 0},
        "sla": {"type": "object", "description": "The client's SLA in force (since v0.21.0): time zone, calendar, priorities, day of the run, history known"}
      }
    },
    "totals": {
      "type": "object",
      "required": ["findings", "assets", "needs_review", "assumed_inputs", "not_affected", "errors"],
      "properties": {
        "findings": {"$ref": "#/$defs/counts"},
        "assets": {"$ref": "#/$defs/counts", "description": "Assets carrying at least one finding of each level"},
        "needs_review": {"type": "integer", "minimum": 0},
        "assumed_inputs": {"type": "integer", "minimum": 0},
        "not_affected": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0}
      }
    },
    "by_exposure": {
      "type": "object",
      "required": ["open", "controlled", "small"],
      "additionalProperties": {"$ref": "#/$defs/counts"}
    },
    "by_zone": {"type": "object", "additionalProperties": {"$ref": "#/$defs/counts"}},
    "deadlines": {
      "type": "object",
      "required": ["overdue", "due_soon", "by_timeline"],
      "description": "ACT and ATTEND findings; due date = first observation + BOD 26-04 delay",
      "properties": {
        "overdue": {"type": "integer", "minimum": 0},
        "due_soon": {"type": "integer", "minimum": 0, "description": "Due within 7 days"},
        "by_timeline": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "sla": {
          "type": "object",
          "description": "The client's SLA (since v0.21.0): open decisions with a priority, past their SLA due date, due within 7 days, and those in no priority",
          "properties": {
            "overdue": {"type": "integer", "minimum": 0},
            "due_soon": {"type": "integer", "minimum": 0},
            "unclassified": {"type": "integer", "minimum": 0},
            "by_priority": {"type": "object", "additionalProperties": {"type": "object"}}
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "asset", "cve", "level", "ssvc", "bod_timeline", "kev", "needs_review"],
        "properties": {
          "finding_id": {"type": "string"},
          "asset": {"type": "string"},
          "asset_name": {"type": "string"},
          "zone": {"type": "string"},
          "exposure": {"type": "string"},
          "exposure_source": {"type": "string"},
          "cve": {"type": "string", "pattern": "^CVE-\\d{4}-\\d{4,}$"},
          "title": {"type": "string"},
          "level": {"enum": ["ACT", "ATTEND", "TRACK"]},
          "ssvc": {"type": "string"},
          "bod_timeline": {"type": "string"},
          "first_seen": {"type": ["string", "null"]},
          "due_date": {"type": ["string", "null"]},
          "kev": {"type": "boolean"},
          "epss": {"type": ["number", "null"]},
          "needs_review": {"type": "boolean"},
          "rationale": {"type": "string"},
          "cvss_score": {"type": ["number", "null"], "description": "Base score of the CVSS metric used (since v0.11.6)"},
          "cvss_version": {"type": "string"},
          "severity": {"enum": ["Critical", "High", "Medium", "Low", "Unknown"], "description": "CVSS qualitative rating; Unknown without a score"},
          "fix_available": {"type": "boolean", "description": "A fixed version or a patch is known (scanner or CVE record)"},
          "vendor": {"type": "string"},
          "product": {"type": "string"},
          "product_type": {"enum": ["application", "os", "hardware", "unknown"], "description": "CPE part of the vulnerable product"},
          "sources": {"type": "array", "items": {"type": "string"}, "description": "Detection sources that observed the finding"},
          "seen_by": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Last observation of the finding per source (since v0.18.1)"},
          "priority": {"type": "string", "description": "Priority of the client's SLA, \"\" in none or without an SLA (since v0.21.0, HLD D19)"},
          "priority_rank": {"type": ["integer", "null"], "description": "0 for the most urgent priority of the client"},
          "sla_rule": {"type": ["integer", "null"], "description": "Rule of the client's SLA applied, 1 for the first"},
          "sla_since": {"type": ["string", "null"], "description": "Day the decision entered its priority"},
          "sla_due": {"type": ["string", "null"], "description": "Due date of the client's SLA; due_date stays the BOD 26-04 one"},
          "sla_since_source": {"type": "string", "description": "run, history, level_since or first_seen (no history known)"},
          "sla_status": {"enum": ["on-track", "overdue", null], "description": "Past its SLA due date or not, on the day of the run"}
        }
      }
    },
    "exposure_gaps": {
      "type": "array",
      "description": "Exposures the client profile does not describe (since v0.11.4); from the asset graph since v0.24.0: declared-small-but-reachable, undeclared-flow, no-external-scan (asset empty: the whole run)",
      "items": {
        "type": "object",
        "required": ["kind", "asset"],
        "properties": {
          "kind": {"enum": ["unlisted", "declared-not-open", "declared-small-but-reachable", "undeclared-flow", "no-external-scan"]},
          "asset": {"type": "string"},
          "name": {"type": "string"},
          "declared": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    },
    "assets": {
      "type": "array",
      "description": "Every asset of the run, with or without a finding (since v0.18.1; before, the assets of the findings)",
      "items": {
        "type": "object",
        "required": ["id", "name", "counts"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "zone": {"type": "string"},
          "exposure": {"type": "string"},
          "owner": {"type": "string"},
          "counts": {"$ref": "#/$defs/counts"},
          "kind": {"type": "string"},
          "scans": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Last scan of the asset per source, a scan without finding included (since v0.18.1)"},
          "last_seen": {"type": "string"},
          "cmdb_class": {"type": "string", "description": "Class of its configuration item in the CMDB (since v0.19.0)"},
          "cmdb_status": {"type": "string", "description": "Status of its configuration item (since v0.19.0)"},
          "criticality": {"type": "string", "description": "Business criticality of its configuration item (since v0.19.0)"},
          "coverage": {"type": "string", "description": "Its scan coverage state (since v0.19.0)"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Scan coverage of the run, as in triage.json (since v0.19.0); empty when the assets were built before"
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "required": ["ACT", "ATTEND", "TRACK"],
      "properties": {
        "ACT": {"type": "integer", "minimum": 0},
        "ATTEND": {"type": "integer", "minimum": 0},
        "TRACK": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}

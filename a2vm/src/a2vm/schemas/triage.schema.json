{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a2vm.triage/1",
  "title": "Triage of a run: every decision of one tenant",
  "description": "Written by verdict run (triage.json), pushed to verdict serve (LLD triage-prioritization §15). Within /1 fields are only added.",
  "type": "object",
  "required": [
    "schema",
    "client",
    "generated_at",
    "cve_count",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": "a2vm.triage/1"
    },
    "client": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "name": {
          "type": "string"
        },
        "profile_updated": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "enum": [
            "en",
            "fr"
          ],
          "description": "Language of the client's deliverables (v0.17.3)"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "minLength": 10
    },
    "cve_count": {
      "type": "integer",
      "minimum": 0
    },
    "llm_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cve_id",
          "asset_id",
          "delivery_decision",
          "ssvc_decision",
          "rationale"
        ],
        "properties": {
          "cve_id": {
            "type": "string",
            "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
          },
          "asset_id": {
            "type": "string"
          },
          "asset_id_full": {
            "type": "string"
          },
          "finding_id": {
            "type": "string"
          },
          "delivery_decision": {
            "enum": [
              "ACT",
              "ATTEND",
              "TRACK"
            ]
          },
          "ssvc_decision": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "rationale_source": {
            "type": "string"
          },
          "needs_review": {
            "type": "boolean"
          },
          "in_kev": {
            "type": "boolean"
          },
          "epss": {
            "type": [
              "number",
              "null"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sla": {
            "type": "object",
            "description": "Priority and SLA of the client (since v0.21.0, HLD D19): absent or empty when the client has no `sla` section; priority \"\" when no rule matches (the BOD 26-04 due date stays the only one).",
            "properties": {
              "priority": {
                "type": "string"
              },
              "rank": {
                "type": "integer",
                "minimum": 0,
                "description": "0 for the most urgent priority (the first named in the rules)"
              },
              "rule": {
                "type": "integer",
                "minimum": 1,
                "description": "the rule applied, 1 for the first of the profile"
              },
              "days": {
                "type": "integer",
                "minimum": 0
              },
              "calendar": {
                "enum": [
                  "calendar",
                  "business"
                ]
              },
              "holidays": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "extra_holidays": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "since": {
                "type": "string",
                "format": "date",
                "description": "the day the decision entered this priority"
              },
              "since_source": {
                "enum": [
                  "run",
                  "history",
                  "level_since",
                  "first_seen"
                ]
              },
              "due": {
                "type": "string",
                "format": "date"
              },
              "bod_due": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "not_affected": {
      "type": "array"
    },
    "errors": {
      "type": "array"
    },
    "ignored": {
      "type": "array"
    },
    "exposure_gaps": {
      "type": "array"
    },
    "assets": {
      "type": "array",
      "description": "Every asset of the run, with or without a finding: who scanned it and when (v0.18.1).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "exposure": {
            "type": "string"
          },
          "exposure_source": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "os": {
            "type": [
              "string",
              "null"
            ]
          },
          "scans": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "last_seen": {
            "type": "string"
          },
          "ips": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Internal addresses of the asset (since v0.19.0)"
          },
          "cmdb": {
            "type": "array",
            "description": "Configuration items of the CMDB that are this asset: class, key, status, criticality, organization, type (since v0.19.0)",
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "components": {
            "type": "array",
            "description": "Every package installed on the asset (since v0.22.2)",
            "items": {
              "type": "object",
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "arch": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "purl": {
                  "type": "string"
                },
                "vendor": {
                  "type": "string",
                  "description": "The publisher of an application (SentinelOne, Windows agents of Wazuh), matched through the applications table (since v0.23.3)"
                },
                "source_package": {
                  "type": "string",
                  "description": "The source package it is built from (since v0.23.0)"
                },
                "distro": {
                  "type": "string",
                  "description": "The distribution, from /etc/os-release: <ID>-<VERSION_ID> (since v0.23.0)"
                },
                "source": {
                  "type": "string",
                  "description": "Where the component was seen: ssh (the package database) (since v0.23.0)"
                },
                "seen": {
                  "type": "string",
                  "description": "When this source last listed it (since v0.23.0)"
                }
              }
            }
          },
          "components_seen": {
            "type": "string",
            "description": "When the components were observed (since v0.22.2)"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Scan coverage of the client (since v0.19.0, LLD triage §14.6): state of each host asset against the CMDB and the means of detection its class expects; empty for runs whose assets were built before.",
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "cmdb": {
          "type": "boolean",
          "description": "a CMDB took part in the run"
        },
        "stale_days": {
          "type": "integer"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "expected_assets": {
          "type": "integer"
        },
        "covered_share": {
          "type": [
            "number",
            "null"
          ]
        },
        "means": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "asset",
              "name",
              "state"
            ],
            "properties": {
              "asset": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "not-in-cmdb",
                  "retired-but-alive",
                  "not-expected",
                  "not-scannable",
                  "never-scanned",
                  "stale",
                  "partial",
                  "covered"
                ]
              },
              "cmdb_class": {
                "type": "string"
              },
              "cmdb_key": {
                "type": "string"
              },
              "cmdb_status": {
                "type": "string"
              },
              "criticality": {
                "type": "string"
              },
              "cmdb_type": {
                "type": "string"
              },
              "cmdb_items": {
                "type": "integer"
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scans": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "last_scan": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sla": {
      "type": "object",
      "description": "The client's SLA in force for this run (since v0.21.0): time zone, calendar, priorities and rules, the day of the run in that time zone, and whether the history of the tenant's database was known.",
      "properties": {
        "timezone": {
          "type": "string"
        },
        "calendar": {
          "enum": [
            "calendar",
            "business"
          ]
        },
        "priorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array"
        },
        "today": {
          "type": "string",
          "format": "date"
        },
        "history": {
          "type": "boolean"
        }
      }
    }
  }
}

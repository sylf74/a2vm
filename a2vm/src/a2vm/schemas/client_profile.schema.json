{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vulnops/client_profile.schema.json",
  "title": "vulnops client profile",
  "description": "Declared assets, attribute rules and default assumptions for one client. Version 1 profiles (every declared asset fully described) remain valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "updated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "delivery_file": {
          "type": "string",
          "description": "Optional link to the client's delivery-files sheet."
        },
        "language": {
          "enum": ["en", "fr"],
          "description": "Language of the labels of the client's deliverables (daily report, dashboard, documents of the chat, Grafana); default en (since v0.17.3). Alerts: the language of each contact (contacts.yaml)."
        }
      }
    },
    "defaults": {
      "description": "Default assumptions for attributes no declaration, rule or source provides. Every use is flagged in reports. Absent: worst case (open, essential, minimal, unknown owner).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposure": {
          "$ref": "#/$defs/exposure"
        },
        "mission_prevalence": {
          "$ref": "#/$defs/mission_prevalence"
        },
        "public_wellbeing_impact": {
          "$ref": "#/$defs/public_wellbeing_impact"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rules": {
      "description": "Attribute rules for discovered hosts, applied in order; for each attribute the first matching rule wins.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "set"
        ],
        "minProperties": 2,
        "properties": {
          "description": {
            "type": "string"
          },
          "hostname": {
            "type": "string",
            "description": "Glob on the short host name, e.g. 'hyp*'."
          },
          "fqdn": {
            "type": "string",
            "description": "Glob on the FQDN, e.g. '*.dmz.example'."
          },
          "ip": {
            "type": "string",
            "description": "CIDR, e.g. '198.51.100.0/24'."
          },
          "set": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "exposure": {
                "$ref": "#/$defs/exposure"
              },
              "mission_prevalence": {
                "$ref": "#/$defs/mission_prevalence"
              },
              "public_wellbeing_impact": {
                "$ref": "#/$defs/public_wellbeing_impact"
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "zone": {
                "$ref": "#/$defs/zone"
              }
            }
          }
        }
      }
    },
    "assets": {
      "description": "Declared assets or product families (inventory matching). Optional when scanners discover the estate.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "vendor",
          "product"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "vendor": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 1
          },
          "vendor_aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "product_aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "cpe": {
            "type": "string",
            "pattern": "^cpe:2\\.3:[aho]:[^:]+:[^:]+",
            "description": "CPE 2.3 prefix; only the vendor and product fields are used for matching."
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "Deployed versions. Empty or absent: every matching CVE is triaged with version status 'unknown'."
          },
          "exposure": {
            "$ref": "#/$defs/exposure"
          },
          "mission_prevalence": {
            "$ref": "#/$defs/mission_prevalence"
          },
          "public_wellbeing_impact": {
            "$ref": "#/$defs/public_wellbeing_impact"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "description": "Team or mailbox in charge of remediation."
          },
          "zone": {
            "$ref": "#/$defs/zone"
          }
        }
      }
    },
    "alerts": {
      "description": "Alerts drafted by the watch mode (via) for this client, sent after an analyst validates them.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipients": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+$"
          },
          "description": "Client addresses that receive validated alerts."
        },
        "attach": {
          "type": "array",
          "items": {"enum": ["docx", "pdf"]},
          "uniqueItems": true,
          "description": "Files attached to the client's alert mail: docx = the alert sheet in Word, pdf = the same sheet as a PDF made from the Word file at sending time (since v0.11.4). The analysts always receive the Word file, which they may edit."
        },
        "word_template": {
          "type": "string",
          "description": "Word template of the alert sheet, relative to the client project (default: templates/alert.docx when present, else the neutral A2VM template)."
        },
        "level": {
          "enum": [
            "urgent",
            "all"
          ],
          "description": "urgent (default): exploited, CERT-FR alert or Internet-exposed critical; all: also CERT-FR advisories on the client's products."
        },
        "mode": {"enum": ["client", "radar"], "description": "client (default): the news matched with this client's assets and watchlist; radar (v0.22.0): the watch team's radar, the major vulnerabilities whoever they concern, gathered into events (docs/radar.md)."},
        "radar": {"type": "object", "additionalProperties": false, "description": "Thresholds of the radar (mode radar): the magnitude of an event to alert it as info (default 4) or urgent (default 7), the hours within which items gather into one event (72), the days an event is kept (14), the number of CVEs above which a publication is a bulletin that never gathers by a shared CVE (10, v0.22.2).", "properties": {"info": {"type": "integer", "minimum": 1}, "urgent": {"type": "integer", "minimum": 1}, "window_hours": {"type": "integer", "minimum": 1, "maximum": 720}, "keep_days": {"type": "integer", "minimum": 1, "maximum": 90}, "bulk_cves": {"type": "integer", "minimum": 2, "maximum": 1000}}},
        "watchlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "description": "Products the client uses but does not declare as assets, as 'vendor product' (e.g. 'Fortinet FortiOS')."
        }
      }
    },
    "external": {
      "description": "External scan of this client, run in its collection-only external project (A2VM_EXTERNAL_PROJECT); its detection joins the internal run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client"
      ],
      "properties": {
        "client": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Client id written by the external project's collection (its targets.yaml)."
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 1,
          "default": 8,
          "description": "An older external detection is ignored, with a warning."
        }
      }
    },
    "published": {
      "description": "Public endpoints and the internal assets that answer behind them. An external host matching an endpoint joins its asset; the asset and those behind it become exposure open, source external-scan.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint",
          "asset"
        ],
        "properties": {
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "description": "Public host name or address, optional :port (e.g. 'www.example.org:443', '203.0.113.10')."
          },
          "asset": {
            "type": "string",
            "minLength": 1,
            "description": "Internal asset answering on the internet: declared asset id, or host name / FQDN of a scanned host."
          },
          "behind": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Assets reached through it (declared ids, host names or FQDNs)."
          },
          "zone": {
            "$ref": "#/$defs/zone"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "description": "Scan coverage (v0.19.0): when the last scan of an asset is stale, and which means of detection each CMDB class expects.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stale_days": {
          "type": "integer",
          "minimum": 1,
          "default": 7,
          "description": "An asset not scanned for this many days is stale."
        },
        "expected": {
          "type": "object",
          "description": "CMDB class (Server, VirtualMachine, PC, IoTDevice... or default) -> means expected, each entry one source or several separated by | (one of them is enough). A class given replaces the default of that class only.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+(\\|[a-z0-9-]+)*$"
            }
          }
        }
      }
    },
    "sla": {
      "description": "Priorities and SLA of the client (v0.21.0, HLD D19): the BOD 26-04 timelines are the default; the first rule that matches a decision gives its priority and its delay, from the day the decision enters that priority. The level (ACT, ATTEND, TRACK) does not change.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "description": "IANA time zone of the client's days (default UTC), e.g. Europe/Paris."
        },
        "calendar": {
          "enum": [
            "calendar",
            "business"
          ],
          "description": "calendar: every day counts (24/7, follow the sun); business: Monday to Friday, less the public holidays."
        },
        "holidays": {
          "oneOf": [
            {
              "enum": [
                "FR"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "FR"
                ]
              }
            }
          ],
          "description": "Public holidays left out of business days: FR (metropolitan France)."
        },
        "extra_holidays": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "description": "Other days left out of business days (a closure, a local holiday), YYYY-MM-DD."
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "description": "Most urgent priority first; the first rule that matches applies.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "priority",
              "days"
            ],
            "properties": {
              "priority": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,15}$",
                "description": "Free name: P0, P1, Q0..."
              },
              "days": {
                "type": "integer",
                "minimum": 0,
                "description": "Delay, counted in the rule's calendar."
              },
              "calendar": {
                "enum": [
                  "calendar",
                  "business"
                ],
                "description": "calendar: every day counts (24/7, follow the sun); business: Monday to Friday, less the public holidays."
              },
              "holidays": {
                "oneOf": [
                  {
                    "enum": [
                      "FR"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "enum": [
                        "FR"
                      ]
                    }
                  }
                ],
                "description": "Public holidays left out of business days: FR (metropolitan France)."
              },
              "extra_holidays": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "description": "Other days left out of business days (a closure, a local holiday), YYYY-MM-DD."
              },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "description": "Every criterion must hold; none: every decision.",
                "properties": {
                  "level": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1
                      }
                    ]
                  },
                  "kev": {
                    "type": "boolean"
                  },
                  "exposure": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1
                      }
                    ]
                  },
                  "zone": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1
                      }
                    ]
                  },
                  "epss": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "minProperties": 1,
                        "properties": {
                          "min": {
                            "type": "number"
                          },
                          "max": {
                            "type": "number"
                          }
                        }
                      }
                    ]
                  },
                  "cvss": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "minProperties": 1,
                        "properties": {
                          "min": {
                            "type": "number"
                          },
                          "max": {
                            "type": "number"
                          }
                        }
                      }
                    ]
                  },
                  "cmdb": {
                    "type": "object",
                    "description": "Fields of the asset's CMDB item: criticality, class, status, organization, type...",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "required": [
          "assets"
        ],
        "properties": {
          "assets": {
            "minItems": 1,
            "items": {
              "required": [
                "exposure",
                "mission_prevalence",
                "public_wellbeing_impact",
                "owner"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "exposure": {
      "enum": [
        "open",
        "controlled",
        "small",
        "internet",
        "internal",
        "isolated"
      ],
      "description": "SSVC System Exposure. open = reachable from the internet or another widely accessible network, access cannot plausibly be restricted (CISA 'Publicly Exposed'); controlled = networked, access restricted or protected by measures that reliably interrupt an attack; small = local service, or a highly controlled or isolated network. Deprecated: internet (read as open), internal (controlled), isolated (small)."
    },
    "zone": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Free label grouping assets in reports (dmz, lan, ot, admin...); no effect on decisions."
    },
    "mission_prevalence": {
      "enum": [
        "minimal",
        "support",
        "essential"
      ]
    },
    "public_wellbeing_impact": {
      "enum": [
        "minimal",
        "material",
        "irreversible"
      ]
    }
  }
}

# One owner per stage (the product owner of each pillar). Replace @product-owner with each owner's
# GitLab username as they join. On GitLab CE (Free) the owners are shown on merge requests;
# making their approval mandatory requires GitLab Premium.

*               @product-owner

# Common model: schemas, exchange files, settings, LLM client
/core/          @product-owner

# Intelligence
/intel/         @product-owner

# Detection
/detect/        @product-owner

# Asset inventory
/assets/        @product-owner

# Triage
/verdict/       @product-owner

# Remediation
/remediate/     @product-owner

# Client pipeline template (runs in every client project)
/templates/     @product-owner
